{
  "name": "@coffee-connect/api",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for Coffee Connect",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && tsx --test src/services/*.test.ts && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
